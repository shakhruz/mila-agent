#!/bin/bash
# mila — start a Claude Code session with the mila-telegram plugin.
# The full launch flag is too long to type by hand:
#   claude --dangerously-load-development-channels plugin:mila-telegram@mila
# This wrapper also makes sure the channel is alive before the session starts.
#
# The marketplace name comes from the plugin repository's own manifest, so a
# client installing from GitHub gets "@mila". A local development marketplace
# is named whatever its directory says — set MILA_PLUGIN_REF for that case
# instead of editing this file, which is how the two names drifted apart and
# left the launcher pointing at a marketplace no client would ever have.

set -u

# Find the marketplace the plugin actually sits in, rather than assuming.
# Installing from GitHub gives "mila"; a local development marketplace gives
# its own name. The manifest is the authority, the directory name the fallback.
detect_plugin_ref() {
  local dir mk name
  dir="$(ls -d "$HOME"/.claude/plugins/*/mila-telegram 2>/dev/null | head -1)"
  [ -z "$dir" ] && { echo "plugin:mila-telegram@mila"; return; }
  mk="$(dirname "$dir")"
  name="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['name'])" \
          "$mk/.claude-plugin/marketplace.json" 2>/dev/null || true)"
  [ -z "$name" ] && name="$(basename "$mk")"
  echo "plugin:mila-telegram@$name"
}
PLUGIN="${MILA_PLUGIN_REF:-$(detect_plugin_ref)}"
FLAG="--dangerously-load-development-channels"
STATE="${TELEGRAM_STATE_DIR:-$HOME/.claude/channels/telegram}"
DAEMON_UNIT="com.milagpt.telegram-receiver"
# Linux (plan 17.10 item 1): deploy/bootstrap.sh installs the receiver as a systemd --user unit; launchctl is macOS only.
SD_RECEIVER="${MILA_SD_RECEIVER:-mila-telegram-receiver}"
# svc receiver — (re)start the receiver daemon the way this OS runs it; silent if there is no such unit.
svc() {
  if [ "$(uname -s)" = "Darwin" ]; then
    local u="$DAEMON_UNIT"
    launchctl kickstart -k "gui/$(id -u)/$u" 2>/dev/null \
      || { [ "$1" = receiver ] && launchctl load "$HOME/Library/LaunchAgents/$u.plist" 2>/dev/null; }
  elif command -v systemctl >/dev/null 2>&1; then
    local u="$SD_RECEIVER"
    systemctl --user cat "$u" >/dev/null 2>&1 && systemctl --user restart "$u" 2>/dev/null
  fi
  return 0
}

c_ok=$'\033[32m'; c_bad=$'\033[31m'; c_dim=$'\033[2m'; c_off=$'\033[0m'

# The channel must be up BEFORE the session starts: while no session is running,
# the daemon keeps collecting inbound messages into the journal, so none are lost.
# Claude Code keeps a folder's conversations in ~/.claude/projects/<the folder with every non-letter-digit as «-»>/*.jsonl.
# None there (a fresh install) — `--continue` has nothing to resume and Claude Code quits after the trust questions.
has_session() {
  local d="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(pwd -P | sed 's/[^A-Za-z0-9]/-/g')"
  compgen -G "$d/*.jsonl" >/dev/null 2>&1
}

ensure_daemon() {
  if ! pgrep -f "receiver.ts" >/dev/null 2>&1; then
    echo "${c_dim}receiver is down — starting it${c_off}"
    svc receiver
    sleep 2
  fi
}

status() {
  local cur sz behind q
  cur=$(cat "$STATE/inbound/cursor" 2>/dev/null || echo 0)
  # `wc -c < missing` печатает ошибку самим шеллом, мимо 2>/dev/null, а статус
  # берётся у `tr`, поэтому `||` не срабатывает и sz остаётся пустой. На чистой
  # машине это давало ошибку на экране и зелёное «replayed ( B)» — первое, что
  # видит клиент, выглядело одновременно как поломка и как успех.
  if [ -f "$STATE/inbound/events.jsonl" ]; then
    sz=$(wc -c < "$STATE/inbound/events.jsonl" | tr -d ' ')
  else
    sz=""
  fi
  echo "── mila-telegram channel ──"
  if pgrep -f "receiver.ts" >/dev/null 2>&1; then
    echo "  receiver   ${c_ok}up${c_off}     $(pgrep -f receiver.ts | head -1)"
  else
    echo "  receiver   ${c_bad}DOWN${c_off}   inbound messages are being lost"
  fi
  if pgrep -f "bun server.ts" >/dev/null 2>&1; then
    echo "  bridge     ${c_ok}up${c_off}"
  else
    echo "  bridge     ${c_dim}no session${c_off}"
  fi
  if [ -z "$sz" ]; then
    echo "  journal    ${c_dim}empty${c_off}  the bot has not received anything yet"
    return 0
  fi
  behind=$(( sz - cur ))
  if [ "$behind" -le 0 ]; then
    echo "  journal    ${c_ok}replayed${c_off} (${sz} B)"
  else
    echo "  journal    ${c_bad}${behind} B not replayed${c_off} (cursor ${cur} / ${sz})"
  fi
}


# Unread inbound messages: what the bridge replayed but the terminal did not show.
inbox() {
  local ev="$STATE/inbound/events.jsonl" seen_f="$STATE/inbound/seen" limit="${1:-20}"
  python3 - "$ev" "$seen_f" "$limit" <<'PY'
import json, os, sys
ev, seen_f, limit = sys.argv[1], sys.argv[2], int(sys.argv[3])
try: seen = int(open(seen_f).read().strip() or 0)
except Exception: seen = 0
# На свежей машине журнала ещё нет, и это норма, а не сбой. Трейсбек здесь
# читается клиентом как «сломалось при первом запуске».
if not os.path.exists(ev):
    print("journal is empty — the bot has not received anything yet")
    raise SystemExit(0)
size = os.path.getsize(ev)
rows = []
with open(ev, "rb") as f:
    f.seek(seen)
    offset = seen
    for line in f:
        start, offset = offset, offset + len(line)
        try:
            e = json.loads(line); m = e.get("params", {}).get("meta", {}) or {}
        except Exception: continue
        u = m.get("user") or ""
        # Только болтовню ботов отбрасываем. Человек без @username — обычное
        # дело у наших клиентов, а раньше он просто не появлялся в списке:
        # хук его показывал как id:…, а эта команда молча выбрасывала.
        if u.endswith("_bot"): continue
        who = u or f"id:{m.get('user_id', '?')}"
        txt = (e["params"].get("content") or "").replace("\n", " ")[:110]
        att = " [file]" if m.get("image_path") or m.get("attachment_file_id") else ""
        rows.append((offset, f"  {m.get('chat_id')}/{m.get('message_id')}  {who}{att}: {txt}"))
if not rows:
    print("no unread messages")
    open(seen_f, "w").write(str(size))
else:
    shown = rows[:limit]
    print(f"── {len(rows)} unread ──")
    for _o, r in shown: print(r)
    if len(rows) > limit:
        print(f"  … {len(rows)-limit} more, run: mila inbox {len(rows)}")
    # Прочитанным помечается ровно показанное. Раньше маркер прыгал на конец
    # файла, и всё, что не влезло в limit, исчезало — включая подсказку выше,
    # которая после этого гарантированно отвечала «no unread messages».
    open(seen_f, "w").write(str(size if len(shown) == len(rows) else shown[-1][0]))
print("(marked as seen)")
PY
}

case "${1:-continue}" in
  status|st)   status ;;
  inbox|in)    shift; inbox "${1:-20}" ;;
  usage|u)     shift
               # Собиратель лежит рядом со скиллом; если кит поставлен
               # установщиком, он в hooks/ рядом с хуком входящих.
               for c in "$HOME/.claude/hooks/usage_collect.py" \
                        "$HOME/.claude/skills/mila-session/usage_collect.py" \
                        "$(dirname "$0")/usage_collect.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "usage_collect.py not found — reinstall the kit" >&2; exit 1 ;;
  turns|t)     shift
               for c in "$HOME/.claude/hooks/turns_collect.py" \
                        "$(dirname "$0")/turns_collect.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "turns_collect.py not found — reinstall the kit" >&2; exit 1 ;;
  records|rec) shift
               for c in "$HOME/.claude/hooks/records.py" \
                        "$(dirname "$0")/records.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "records.py not found — reinstall the kit" >&2; exit 1 ;;
  tasks)       shift
               for c in "$HOME/.claude/hooks/tasks.py" \
                        "$(dirname "$0")/tasks.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "tasks.py not found — reinstall the kit" >&2; exit 1 ;;
  chats|c)     shift
               for c in "$HOME/.claude/hooks/chats_index.py" \
                        "$HOME/.claude/skills/mila-session/chats_index.py" \
                        "$(dirname "$0")/chats_index.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "chats_index.py not found — reinstall the kit" >&2; exit 1 ;;
  owe|note)    shift
               for c in "$HOME/.claude/hooks/chat_note.py" \
                        "$(dirname "$0")/chat_note.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "chat_note.py not found — reinstall the kit" >&2; exit 1 ;;
  onboard|ob)  shift
               for c in "$HOME/.claude/hooks/onboard.py" \
                        "$(dirname "$0")/onboard.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "onboard.py not found — reinstall the kit" >&2; exit 1 ;;
  birth)       shift
               for c in "$HOME/.claude/hooks/birth.py" \
                        "$(dirname "$0")/birth.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "birth.py not found — reinstall the kit" >&2; exit 1 ;;
  doctor|doc)  shift
               for c in "$HOME/.claude/hooks/doctor.py" \
                        "$(dirname "$0")/doctor.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "doctor.py not found — reinstall the kit" >&2; exit 1 ;;
  when|tz)     shift
               for c in "$HOME/.claude/hooks/chat_locale.py" \
                        "$(dirname "$0")/chat_locale.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "chat_locale.py not found — reinstall the kit" >&2; exit 1 ;;
  backup|bak)  shift
               for c in "$HOME/.claude/hooks/backup.py" \
                        "$(dirname "$0")/backup.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$@"
               done
               echo "backup.py not found — reinstall the kit" >&2; exit 1 ;;
  export|restore) cmd="$1"; shift
               case "${1:-}" in verify|scan|restore|export) cmd="$1"; shift ;; esac
               for c in "$HOME/.claude/skills/mila-export/mila_export.py" \
                        "$(dirname "$0")/../skills/mila-export/mila_export.py"; do
                 [ -f "$c" ] && exec python3 "$c" "$cmd" "$@"
               done
               echo "mila-export skill not found — reinstall the kit" >&2; exit 1 ;;
  fix)         svc receiver
               sleep 2; status ;;
  new|n)       ensure_daemon; shift; exec claude $FLAG "$PLUGIN" "$@" ;;
  pick|p)      ensure_daemon; shift; exec claude $FLAG "$PLUGIN" --resume "$@" ;;
  help|-h|--help)
               cat <<'HELP'
mila            resume the last session with the plugin (--continue); none in this folder yet — a new one
mila new        start a fresh session
mila pick       choose a session from the list (--resume)
mila status     channel health: receiver, bridge, journal
mila birth      first setup on a local web page: bot token, Claude sign-in, pair with your bot (plain `mila` opens it until you are set up)
mila onboard    the same three checked steps in the terminal (--check)
mila doctor     full diagnosis: token, privacy mode, access, daemon, permissions
mila inbox      show unread inbound messages and mark them seen
mila fix        restart the receiver (leaves the session alone)
mila usage      token spend by day and model (--days 7 --by-model)
mila turns      collect turns from the transcripts into conversations.db
mila records    show turns | external | check — the ledgers (see docs/accounting.md)
mila tasks      start --kind post | done <id> [--outcome redo|complaint] | report --days 7 — cost and outcome per task type
mila chats      rebuild the chat registry (--stale 14 lists quiet ones)
mila owe        every open promise across all chats
mila when       what time it is for each client, and who is in quiet hours
mila backup     status | run | list — archive what cannot be recovered
mila export     [--out DIR] [--with-history] — export this Mila (no secrets) · mila export verify <archive>
mila restore    <archive> [--dry-run] [--overwrite] — revive a Mila from an export archive
mila note <id>  write to a chat card (--purpose --member --promise --done --note)

Anything after the command is passed to claude as-is:  mila new --model opus
HELP
               ;;
  *)           # Not born yet: the birth page instead of a session. Born is decided from files on this machine, never from
               # the network: a birth record, or (a home set up in the terminal before the page existed) a saved bot token
               # together with access.json AND an owner written by the pairing (OWNER_ID in settings.json). A token and
               # access.json alone are not enough: a Claude Code that already had a Telegram channel of its own has both
               # and no Mila. A network blip or an expired Claude sign-in must not send a living Mila back to the birth
               # page — the session and `mila doctor` speak about those.
               bi=""; born=0; cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
               [ -f "$cfg/mila-birth.json" ] && born=1
               [ -f "$STATE/.env" ] && [ -f "$STATE/access.json" ] && grep -q '"OWNER_ID"' "$cfg/settings.json" 2>/dev/null && born=1
               for c in "$HOME/.claude/hooks/birth.py" "$(dirname "$0")/birth.py"; do [ -f "$c" ] && { bi="$c"; break; }; done
               if [ "$born" = 0 ] && [ -n "$bi" ]; then
                 exec python3 "$bi"
               fi
               ensure_daemon
               if has_session; then exec claude $FLAG "$PLUGIN" --continue "$@"; fi
               echo "${c_dim}first start in this folder — a new conversation (same as: mila new)${c_off}"
               exec claude $FLAG "$PLUGIN" "$@" ;;
esac
