{
  "permissions": {
    "allow": [
      "mcp__plugin_mila-telegram_telegram",
      "Read({work}/**)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/hooks/**)",
      "Read(~/.claude/channels/**/inbox/**)",
      "Edit({work}/**)",
      "Write({work}/**)",
      "WebSearch"
    ],
    "deny": [
      "Edit({work}/.mcp.json)",
      "Write({work}/.mcp.json)",
      "Edit({work}/.git/**)",
      "Write({work}/.git/**)",
      "Edit({work}/.claude/**)",
      "Write({work}/.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B {hooks}/run-allow.py"
          }
        ]
      }
    ]
  }
}
