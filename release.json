{
  "product": "Mila Agent",
  "version": "1.7.14",
  "tag": "v1.7.14",
  "date": "2026-11-14",
  "notes": "CHANGELOG.md - section v1.7.14",
  "zones": [
    {
      "what": "навыки ядра",
      "src": "skills/*",
      "dst": "{claude}/skills/*",
      "kind": "dir"
    },
    {
      "what": "старые имена навыков — алиасы до v1.7.0 (только для обновления: старые пути скриптов)",
      "src": "legacy/skills/*",
      "dst": "{claude}/skills/*",
      "kind": "dir"
    },
    {
      "what": "хуки и инструменты",
      "src": "install/*.py",
      "dst": "{claude}/hooks/*",
      "kind": "file",
      "skip": [
        "test_*.py"
      ]
    },
    {
      "what": "вход в Claude из Telegram (для фоновой службы)",
      "src": "docker/claude_login.py",
      "dst": "{claude}/hooks/*",
      "kind": "file"
    },
    {
      "what": "что можно фоновому сеансу без человека у экрана",
      "src": "install/mila-run-settings.json",
      "dst": "{claude}/hooks/*",
      "kind": "file"
    },
    {
      "what": "переводы хуков (doctor)",
      "src": "install/locales/*.json",
      "dst": "{claude}/hooks/locales/*",
      "kind": "file"
    },
    {
      "what": "запускатель",
      "src": "install/mila",
      "dst": "{home}/.local/bin/mila",
      "kind": "file"
    },
    {
      "what": "конституция",
      "src": "CONSTITUTION.md",
      "dst": "{work}/CONSTITUTION.md",
      "kind": "file"
    },
    {
      "what": "хуки шаблона",
      "src": "templates/home/.claude/hooks/*.py",
      "dst": "{claude}/hooks/*",
      "kind": "file",
      "skip": [
        "test_*.py"
      ]
    },
    {
      "what": "каноны",
      "src": "canon/*.md",
      "dst": "{work}/canon/*",
      "kind": "file",
      "skip": [
        "TEAM-CONTACTS*"
      ]
    }
  ],
  "never": [
    "{work}/NOW.md",
    "{work}/USER.md",
    "{work}/CLIENTS.md",
    "{work}/DECISIONS.md",
    "{work}/CLAUDE.md",
    "{work}/memory",
    "{work}/journal",
    "{work}/BACKLOG.md",
    "{work}/AUTO-POOL.md",
    "{work}/PERMISSIONS.md",
    "{claude}/settings.json",
    "{claude}/channels",
    "{claude}/projects",
    "{home}/secrets",
    "{work}/.env",
    "{work}/rituals",
    "{work}/canon/TEAM-CONTACTS.md"
  ],
  "genes": [
    "skills/mila-export",
    "skills/mila-update",
    "install/mila"
  ],
  "genes_note": "every Mila carries these: she can update herself and export herself (owner owns the archive)",
  "renamed": {
    "ekzamen": "exam",
    "kartochki": "cards",
    "lichka-hozyaina": "owner-dm",
    "mila-v-chate": "mila-in-chat",
    "naglyadno": "visual",
    "proverka": "verify",
    "put-gostya": "guest-path",
    "rashod": "spend",
    "topiki": "topics",
    "vhodyashchie": "inbox",
    "vkusy": "tastes",
    "voprosy": "questions",
    "yasno": "plain-words",
    "zadachi": "tasks",
    "znakomstvo": "onboarding",
    "OBDUMYVANIE.md": "THINKING-BUDGET.md"
  },
  "renamed_note": "v1.4.0 international names; old names are aliases in legacy/skills/ (MOVED.md + script wrappers, no SKILL.md), delivered by mila-update to homes that had them, until v1.7.0 (removal needs a migration that checks crons for old paths); fresh installs don't get them",
  "guards_note": "the hooks of the core, one list for the birth template, for the update and for tools/hooks_sync.py: event, matcher, key (how a wired hook is recognised), file (must exist and compile), hook; min_cc — only from this Claude Code version; control — an input the guard must refuse and one it must let through",
  "guards_required_note": "safety, required: a removed one is wired back by the update and the plan says so; a required guard wired with a narrower matcher gets the missing tools. Every other guard is a convenience: removed by the owner, it stays removed",
  "guards_required": [
    "hooks/send-guard.py",
    "hooks/secret-guard.py",
    "hooks/pd-mask.py"
  ],
  "deny_required_note": "permissions.deny rules that keep the sign-in files and the safe closed to the session's tools — required like a safety guard: a removed rule is put back and the plan says so",
  "deny_required": [
    "Read(~/.mila-auth/**)",
    "Edit(~/.mila-auth/**)",
    "Read(~/work/secrets/**)",
    "Edit(~/work/secrets/**)"
  ],
  "guards": [
    {
      "event": "SessionStart",
      "key": "hooks/session-start.py",
      "file": "{claude}/hooks/session-start.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/session-start.py"
      }
    },
    {
      "event": "SessionStart",
      "key": "mila-tasks/hooks/task-open.py",
      "file": "{claude}/skills/mila-tasks/hooks/task-open.py",
      "hook": {
        "type": "command",
        "command": "f=$HOME/.claude/skills/mila-tasks/hooks/task-open.py; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
      }
    },
    {
      "event": "SessionStart",
      "key": "hooks/crons-keeper.py",
      "file": "{claude}/hooks/crons-keeper.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/crons-keeper.py"
      }
    },
    {
      "event": "UserPromptSubmit",
      "key": "hooks/telegram-inbox-feed.py",
      "file": "{claude}/hooks/telegram-inbox-feed.py",
      "hook": {
        "type": "command",
        "command": "$HOME/.claude/hooks/telegram-inbox-feed.py"
      }
    },
    {
      "event": "UserPromptSubmit",
      "key": "hooks/skill-hint.py",
      "file": "{claude}/hooks/skill-hint.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/skill-hint.py"
      }
    },
    {
      "event": "UserPromptSubmit",
      "key": "hooks/hod-stream.py",
      "file": "{claude}/hooks/hod-stream.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/hod-stream.py"
      }
    },
    {
      "event": "PreToolUse",
      "matcher": "mcp__plugin_(mila-)?telegram_telegram__reply|mcp__plugin_(mila-)?telegram_telegram__edit_message|mcp__plugin_(mila-)?telegram_telegram__topic|mcp__plugin_(mila-)?telegram_telegram__widget|mcp__plugin_(mila-)?telegram_telegram__widget_data",
      "key": "hooks/send-guard.py",
      "file": "{claude}/hooks/send-guard.py",
      "control": {
        "deny": {"tool_name": "mcp__plugin_mila-telegram_telegram__reply", "tool_input": {"chat_id": "1", "text": "файл /srv/x"}},
        "allow": {"tool_name": "Bash", "tool_input": {"command": "ls"}}
      },
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/send-guard.py",
        "onFailure": "block"
      },
      "control": {
        "deny": {
          "tool_name": "mcp__plugin_mila-telegram_telegram__reply",
          "tool_input": {
            "chat_id": "1",
            "text": "файл /srv/x"
          }
        },
        "allow": {
          "tool_name": "Bash",
          "tool_input": {
            "command": "ls"
          }
        }
      }
    },
    {
      "event": "PreToolUse",
      "matcher": "mcp__plugin_(mila-)?telegram_telegram__reply|mcp__plugin_(mila-)?telegram_telegram__edit_message|mcp__plugin_(mila-)?telegram_telegram__topic|mcp__plugin_(mila-)?telegram_telegram__widget|mcp__plugin_(mila-)?telegram_telegram__widget_data",
      "key": "hooks/done-guard.py",
      "file": "{claude}/hooks/done-guard.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/done-guard.py"
      }
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|WebFetch|Monitor",
      "key": "hooks/secret-guard.py",
      "file": "{claude}/hooks/secret-guard.py",
      "control": {
        "deny": {"tool_name": "Read", "tool_input": {"file_path": "{home}/.mila-auth/x"}},
        "allow": {"tool_name": "Read", "tool_input": {"file_path": "{home}/work/USER.md"}}
      },
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/secret-guard.py"
      },
      "control": {
        "deny": {
          "tool_name": "Read",
          "tool_input": {
            "file_path": "{home}/.mila-auth/x"
          }
        },
        "allow": {
          "tool_name": "Read",
          "tool_input": {
            "file_path": "{home}/work/USER.md"
          }
        }
      }
    },
    {
      "event": "PreToolUse",
      "key": "hooks/hod-stream.py",
      "file": "{claude}/hooks/hod-stream.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/hod-stream.py"
      }
    },
    {
      "event": "PostToolUse",
      "matcher": "mcp__plugin_(mila-)?telegram_telegram__reply",
      "key": "mila-tasks/hooks/task-sent.py",
      "file": "{claude}/skills/mila-tasks/hooks/task-sent.py",
      "hook": {
        "type": "command",
        "command": "f=$HOME/.claude/skills/mila-tasks/hooks/task-sent.py; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
      }
    },
    {
      "event": "PostToolUse",
      "matcher": "CronCreate|CronDelete",
      "key": "hooks/crons-keeper.py",
      "file": "{claude}/hooks/crons-keeper.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/crons-keeper.py"
      }
    },
    {
      "event": "PostToolUse",
      "matcher": "Write|Edit|MultiEdit",
      "key": "hooks/pd-mask.py",
      "file": "{claude}/hooks/pd-mask.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/pd-mask.py"
      }
    },
    {
      "event": "PostToolUse",
      "key": "hooks/hod-stream.py",
      "file": "{claude}/hooks/hod-stream.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/hod-stream.py"
      }
    },
    {
      "event": "PostToolUseFailure",
      "key": "hooks/done-guard.py",
      "file": "{claude}/hooks/done-guard.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/done-guard.py"
      },
      "min_cc": "2.1.295"
    },
    {
      "event": "Stop",
      "key": "hooks/reply-required.py",
      "file": "{claude}/hooks/reply-required.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/reply-required.py"
      }
    },
    {
      "event": "Stop",
      "key": "hooks/hod-stream.py",
      "file": "{claude}/hooks/hod-stream.py",
      "hook": {
        "type": "command",
        "command": "python3 $HOME/.claude/hooks/hod-stream.py"
      }
    }
  ]
}
