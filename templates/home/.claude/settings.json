{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/session-start.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=$HOME/.claude/skills/mila-tasks/hooks/task-open.py; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/telegram-inbox-feed.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/skill-hint.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_(mila-)?telegram_telegram__reply|mcp__plugin_(mila-)?telegram_telegram__edit_message|mcp__plugin_(mila-)?telegram_telegram__topic|mcp__plugin_(mila-)?telegram_telegram__widget|mcp__plugin_(mila-)?telegram_telegram__widget_data",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/send-guard.py",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/done-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|WebFetch|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/secret-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_(mila-)?telegram_telegram__reply",
        "hooks": [
          {
            "type": "command",
            "command": "f=$HOME/.claude/skills/mila-tasks/hooks/task-sent.py; [ -f \"$f\" ] && exec python3 \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/done-guard.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(~/.mila-auth/**)",
      "Edit(~/.mila-auth/**)",
      "Read(~/work/secrets/**)",
      "Edit(~/work/secrets/**)"
    ]
  }
}
